# Common full-cache config for ImageNet-1k train -> PAE_DINOv2L_d32 latents.
# Source this file from run scripts.

export REPO_ROOT=/workspace/PDM
export EXP_DIR=/workspace/PDM/experiments/2026-05-27-pdm3-ht-imagenet1k-pae-latent-full-cache

# Keep HF cache on the large /workspace filesystem, not the 100G root overlay.
export HF_HOME=${HF_HOME:-/workspace/.cache/huggingface}
export HF_DATASETS_CACHE=${HF_DATASETS_CACHE:-/workspace/.cache/huggingface/datasets}
export HF_HUB_CACHE=${HF_HUB_CACHE:-/workspace/.cache/huggingface/hub}

export DATASET=ILSVRC/imagenet-1k
export SPLIT=train
export EXPECTED_TRAIN_SIZE=1281167
export IMAGE_SIZE=256

export PAE_CONFIG=/workspace/PDM/external/PAE/pae_with_generator/configs/pae/PAE_DINOv2L_d32.yaml
export PAE_CKPT=/workspace/PDM/data/pae_ckpts/PAE_DINOv2L_d32/AE-models/dinov2-large.pt

export LATENT_ROOT=/workspace/PDM/data/pae_latents/PAE_DINOv2L_d32
export SMOKE_OUT=${LATENT_ROOT}/imagenet256_train_full_smoke4096_opt
export FULL_OUT=${LATENT_ROOT}/imagenet256_train_full

# Conservative production parameters: previous sweep showed input pipeline bound.
# The optimized builder crops once, flips batch on GPU, and uses CPU prefetch threads.
export BATCH_SIZE=${BATCH_SIZE:-512}
export SHARD_SIZE=${SHARD_SIZE:-4096}
export PREPROCESS_WORKERS=${PREPROCESS_WORKERS:-12}
export PREFETCH_BATCHES=${PREFETCH_BATCHES:-4}
export MODEL_DTYPE=${MODEL_DTYPE:-bf16}
export SAVE_DTYPE=${SAVE_DTYPE:-bf16}
export DEVICE=${DEVICE:-cuda:0}

# Raw-first/offline staging path: mirror HF parquet files locally, then encode from local parquet.
export RAW_ROOT=${RAW_ROOT:-/workspace/PDM/data/raw}
export IMAGENET1K_PARQUET_DIR=${IMAGENET1K_PARQUET_DIR:-${RAW_ROOT}/imagenet1k_hf_parquet}
export IMAGENET1K_TRAIN_PARQUET_GLOB=${IMAGENET1K_TRAIN_PARQUET_GLOB:-${IMAGENET1K_PARQUET_DIR}/data/train-*.parquet}
export DOWNLOAD_WORKERS=${DOWNLOAD_WORKERS:-16}
