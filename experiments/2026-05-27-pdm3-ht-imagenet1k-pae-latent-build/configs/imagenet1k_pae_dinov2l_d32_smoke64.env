# Smoke command defaults for HF ImageNet-1k -> PAE_DINOv2L_d32 latent extraction.
# Source dataset is gated; run `huggingface-cli login` or export HF_TOKEN after accepting dataset terms.
DATASET=ILSVRC/imagenet-1k
SPLIT=train
PAE_CONFIG=/workspace/PDM/external/PAE/pae_with_generator/configs/pae/PAE_DINOv2L_d32.yaml
PAE_CKPT=/workspace/PDM/data/pae_ckpts/PAE_DINOv2L_d32/AE-models/dinov2-large.pt
OUTPUT_DIR=/workspace/PDM/data/pae_latents/PAE_DINOv2L_d32/imagenet256_train_smoke64
IMAGE_SIZE=256
MAX_SAMPLES=64
BATCH_SIZE=8
SHARD_SIZE=64
MODEL_DTYPE=bf16
SAVE_DTYPE=bf16
HF_TOKEN_ENV=HF_TOKEN
